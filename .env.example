# Agent Dave / Axon — Environment Variables
# Copy this file to .env and fill in your values

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
MODEL_PROVIDER=anthropic   # set to "stub" for offline testing

# === Target Repo (operations-dashboard or any local repo) ===
TARGET_REPO_PATH=/path/to/your/target-repo

# === GitHub ===
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BASE_BRANCH=main

# === Axon ===
AXON_DB_PATH=data/axon.db
ARTIFACTS_BASE_PATH=artifacts/
